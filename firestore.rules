rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Comentarios por fondo de pantalla
    match /comentarios/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /comments/{wallpaperId}/thread/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Calificaciones de estrellas
    match /estrellas/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /ratings/{wallpaperId}/votes/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sistema de seguidores (Follow / Unfollow)
    match /seguidores/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Envíos y fondos para revisión
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /fondos_revision/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /prueba_1/{docId} {
      allow read, write: if request.auth != null;
    }

    // Novedades
    match /news/{newsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
